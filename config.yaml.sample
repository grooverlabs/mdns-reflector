# mdns-reflector.yaml (Empty / Ready for Configuration)
log_level: "info"

# 1. Define your network interfaces and group them.
# 'name' must match your Linux interface name (e.g. vlan.10, eth0.20)
# 'group' is a label used to write rules below.
interfaces:
#  - { name: "vlan.10", group: "users" }
#  - { name: "vlan.19", group: "gl_iot" }

# 2. Define the behavior between groups.
# 'stateful: true' only reflects responses to interfaces that sent a query recently.
# 'stateful_window' is the window in seconds (defaults to 60 if omitted).
rules:
#  - from: "users"
#    to: ["gl_iot"]
#    types: ["query"]
#  - from: "gl_iot"
#    to: ["users"]
#    types: ["response"]
#    stateful: true
#    stateful_window: 60

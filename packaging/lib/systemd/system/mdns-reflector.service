[Unit]
Description=Stateful mDNS Reflector
Documentation=https://github.com/grooverlabs/mdns-reflector
After=network-online.target
Wants=network-online.target
# Crash-loop guard. StartLimit* are [Unit] settings; in [Service] systemd
# ignores them.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=mdns-reflector
Group=mdns-reflector
ExecStart=/usr/bin/mdns-reflector --config /etc/mdns-reflector/config.yaml

# Restart on crash or socket failure, not on a config error (exit 78).
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78

# Binding :5353, joining multicast groups and IP_PKTINFO need no
# capabilities.
CapabilityBoundingSet=
NoNewPrivileges=true

# Security hardening
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
# AF_NETLINK: listing interfaces and addresses
RestrictAddressFamilies=AF_INET AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SecureBits=no-setuid-fixup no-setuid-fixup-locked
UMask=0077

[Install]
WantedBy=multi-user.target
